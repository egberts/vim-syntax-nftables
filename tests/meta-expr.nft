################################################################################
# false positive test: looks highlighted correctly; has bad content; oops.
# (this is the part where additional Vimscript is needed)
################################################################################

#  - unqualified META, with a value (no 'meta' needed)
rule T C ip meta oifname { };
rule T C ip meta skgid { };
rule T C ip meta skuid { };

rule T C ip meta mark ;  # missing info

rule T C iif ;  # missing interface name


rule T C ip meta iifgroup { };
rule T C ip meta oifgroup { };

#  - qualified META, with a value (requires 'meta' before it)
rule T C ip meta length 65536;
rule T C ip meta length { };
rule T C ip meta protocol ip;
# 'meta random' - qualified META, but without a value

table T {
  chain C {
    symhash mod 5 offset 2;
    ip protocol icmp symhash mod 5 offset 2;
  }
}

