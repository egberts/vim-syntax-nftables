rule T C ip meta oifgroup in @my_set_of_ifgroups;
rule T C ip meta oifgroup not in { 1,2,4 };
rule T C ip meta oifgroup not in @my_set_of_ifgroups;
rule T C ip meta cgroup 12345678;
rule T C ip meta cgroup 12345678901234567890;
rule T C ip meta cgroup 0x1;
rule T C ip meta cgroup 0x01;
rule T C ip meta cgroup 0x0123;
rule T C ip meta cgroup 0x01234567;
rule T C ip meta cgroup == 12345678;
rule T C ip meta cgroup != 12345678;
rule T C ip meta cgroup < 12345678;
rule T C ip meta cgroup <= 12345678;
rule T C ip meta cgroup > 12345678;
rule T C ip meta cgroup >= 12345678;
rule T C ip meta cgroup in { 1,2,3,4 };
