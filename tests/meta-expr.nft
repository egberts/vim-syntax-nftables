#!/usr/sbin/nft -f
# File: meta-expr.nft
# Description: A test NFT file to exercise 'meta' Vim syntax highlightings.
#
# Note: for 'meta' as an expression ('meta_expr') see test/meta-expr.nft
# Note: for 'meta' as a key ('meta_key'), see test/meta-key.nft
# Note: for unqualified 'meta', see test/meta-key-unqualified.nft
# Note: for qualified 'meta', see test/meta-key-qualified.nft
#
# If it's followed by a set, it's likely . 
# If it's followed by a field name and then a comparison (==, <, etc.),
# it's meta_expr.
#
#  is followed by a set.
# meta_expr is followed by a comparison.
# meta_expr is followed by a field name.
#
#     meta subkey  Operand Type  Notes / Example
#     iif          integer       Interface index
#     oif          integer       Interface index
#     iifname      string        "eth0"
#     oifname      string        "wlan0"
#     iifgroup     integer       Interface group ID
#     oifgroup     integer       Interface group ID
#     iiftype      integer       Interface type (see Linux if_arp.h)
#     oiftype      integer       Interface type
#     ibrname      string        Ingress bridge name
#     obrname      string        Egress bridge name
#     ibriport     string        Ingress bridge port name
#     obriport     string        Egress bridge port name
#     mark         integer       Packet mark
#     priority     integer       Priority of packet (qdisc)
#     length       integer       Packet length
#     protocol     integer/symbolic    Layer 4 protocol (e.g., tcp)
#     pkttype      symbolic      unicast, broadcast, multicast
#     nfproto      symbolic      ip, ip6, inet, etc.
#     rtclassid    integer       Routing class ID
#     skuid        integer       Socket UID
#     skgid        integer       Socket GID
#     secmark      integer       SELinux security mark
#     nftrace      boolean (0/1)    Packet tracing flag
#     cgroup       integer       CGroup v2 classid
#     ipsec        boolean (0/1)    Whether packet is IPsec encapsulated
#     cpu          integer       CPU ID that handled the packet
#     time         integer       Seconds since epoch
#     day          symbolic      monday, tuesday, ..., sunday
#     hour         integer (0–23)    Hour of day
#
# 'meta' keyword is almost always followed by a value (except for 'random', 'nftrace', 'ipsec')
#
# There are a few meta keys that do not require a value and behave like flags:
#    Meta key    Notes
#    random      Used as a condition; no operand
#    nftrace     Used as a condition; defaults to "set"
#    ipsec       Acts like a boolean flag in conditionals
#
# But in some contexts (like expressions), they may still support an explicit value:
#
# meta nftrace == 1
# meta ipsec == 0
#
# So:
#
#     In statements, meta nftrace can appear without a value.
#
#     In expressions, it usually appears with == 0/1 or similar.
#
#     Form               Requires Operand?    Example
#     meta iifname       ✅ Yes               meta iifname "eth0"
#     meta rtclassid     ✅ Yes               meta rtclassid 10
#     meta random        ❌ No                meta random
#     meta nftrace       ❌ No (usually)      meta nftrace
#     meta nftrace == 1  ✅ Yes (expr)        meta nftrace == 1
#     meta ipsec         ❌/✅ Depends        meta ipsec or meta ipsec 0
#
# Key Diagnostic: Try putting meta xyz in a log or set
#
#    If it makes sense to assign or print it, it’s being used as a meta_expr.
#
#    If it makes sense to use as a match, it’s a .
#
#⚠️ Gotchas
#
#    You cannot write meta random as a meta_expr. It’s only valid as a statement.
#
#    Some meta keys like secmark, nftrace, random are statement-only, not expressions.

#
# Semantic Action Pathways (parser_bison.y):
#
# Pathway: describe_cmd/primary_expr/hash_expr/expr/concat_expr/basic_expr/primary_expr/meta_expr
# Pathway: describe_cmd/primary_expr/meta_expr
#
################################################################################
# true positive test: properly hightlighted correctly; has good content; perfect
################################################################################

table T {
    chain C {
        meta nfproto ip counter
        meta nfproto ip6 drop
        ip protocol tcp accept
        ip6 nexthdr udp counter
        meta protocol 1 drop     # 1 = ICMP
        meta protocol 0x1 drop     # 1 = ICMP

    }
}

table T {
    chain C {
        ip meta rtclassid 0xffffffff
        ip meta ibriport 7
        ip meta iifgroup 15
        ip meta obriport 7
        ip meta oifgroup 15
        ip meta priority 15
        ip meta protocol 6
        ip meta protocol tcp
        ip meta ibrname "abc0"
        ip meta iifname "br0"
        ip meta iiftype 0xffff
        ip meta nftrace 0
        ip meta nftrace 0
        ip meta nftrace set 1
        ip meta nftrace 0x1
        ip meta nfproto 0xff
        ip meta obrname "abc0"
        ip meta oifname "abc0"
        ip meta oiftype 0xffff
        ip meta pkttype broadcast
        ip meta pkttype 0xf
        ip meta secmark 0xffffffff
        ip meta cgroup 0xffffffffffffffff
        ip meta length 0xffffffff
        ip meta random 4
        ip meta ipsec 0xff
        ip meta skgid 0xffffffff
        ip meta skuid 0xffffffff
        ip meta hour 23
        ip meta mark 0xffffffff
        ip meta time 0xffffffff
        ip meta cpu 0x7fffffff
        ip meta day 0x6
        ip meta iif 0xffffffff
        ip meta oif 0xffffffff
        ip meta notrack 0
        ip meta notrack 0x1
        ip meta notrack 0xff
        ip meta flow 0xffffffff

        ip rtclassid 
        ip ibriport "eth0"
        ip iifgroup 15
        ip obriport 15
        ip oifgroup 15
        ip priority 15
        ip protocol tcp
        ip ibrname 15
        ip iifname "br*"
        ip iiftype 15
        ip nftrace 1
        ip nfproto 15
        ip notrack 15
        ip obrname 15
        ip oifname "eth0"
        ip oiftype 15
        ip pkttype 5
        ip secmark 15
        ip cgroup 15
        ip length 15
        ip random 15
        ip ipsec 15
        ip skgid 15
        ip skuid 15
        ip flow 15
        ip hour 15
        ip mark 15
        ip time 15
        ip cpu 15
        ip day 15
        ip iif 15
        ip oif 15
    }
}

# top-level meta
# 'meta flow' is a top-level meta_stmt action (not a meta key, nor meta_expr)
rule T C ip notrack;
rule T C ip flow @MyDevice;
rule T C ip flow @MyDevice;
rule T C ip flow offload @MyDevice;  # 'flow' is a top-level action (not a meta key)
rule T C ip flow add @MyDevice;  # 'flow' meta key found only in ''

# meta keys, both qualified and unqualified
#  - flags only (support expression only in meta_expr)
rule T C ip meta random <= 0;  # qualified META (requires 'meta' before it)
rule T C ip meta random >= 0;  # qualified META (requires 'meta' before it)
rule T C ip meta random == 0;  # qualified META (requires 'meta' before it)
rule T C ip meta random != 1;  # qualified META (requires 'meta' before it)
rule T C ip meta random set mod 2 == 0;  # 'st' only by meta_stmt, invalid here
rule T C ip meta random == 0;  # qualified META (requires 'meta' before it)

rule T C ip meta ipsec 0;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec == 1;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec exists; # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec missing; # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec missing; # 'meta ipsec 0' only in meta_expr

rule T C ip nftrace == 1;  # must use 'meta nftrace == 1' only in meta_expr
rule T C ip meta nftrace;

# meta_expr - INTERNALS; found in scanner.c (not in parser_bison.y)
# 'meta nfproto' is integer or string (as listed in /etc/protocol)
# meta_expr->META->STRING, where STRING is 'nfproto'
rule ip T C ip6 meta nfproto 1
rule ip T C ip meta nfproto 1;
rule bridge T C ip meta nfproto 1;
rule arp T C ip6 meta nfproto inet;
rule ip6 T C ip meta nfproto 2;
rule ip T C ip meta nfproto ip;
rule ip T C ip meta nfproto 3;
rule ip T C ip meta nfproto arp;
rule ip T C ip meta nfproto 7;
rule ip T C ip meta nfproto bridge;
rule ip T C ip meta nfproto 10;
rule ip T C ip meta nfproto ip6;
rule ip T C ip meta nfproto 12;
rule ip T C ip meta nfproto netdev;
rule ip T C ip meta nfproto 1  # this is ; no meta nfproto in meta_stmt

rule T C ip meta protocol 1;
rule ip T C ip meta protocol icmp;
rule ip6 T C ip meta protocol 6;
rule ip T C ip meta protocol udplite
rule netdev T C iif set meta protocol 17;
rule bridge T C ip meta protocol gretap;
rule arp T C ip meta protocol icmpv6;
rule ip T C ip meta protocol comp;
rule ip T C ip meta protocol dccp;
rule ip T C ip meta protocol icmp;
rule ip T C ip meta protocol igmp;
rule ip T C ip meta protocol sctp;
rule ip T C ip meta protocol esp;
rule ip T C ip meta protocol gre;
rule ip T C ip meta protocol tcp;
rule ip T C ip meta protocol udp;
rule ip T C ip meta protocol ah;

#  - unqualified META, with a value (no 'meta' needed)
rule T C ip mark 64;  # length
rule T C ip mark 64;  # length
rule T C ip iif 2 iif 3 set continue meta setname
rule T C ip iif 2 set return
rule T C ip iif 2 set accept
rule T C ip iif 2 set goto HERE
rule T C ip iif 2 set jump HERE
rule T C ip iif 2 set continue 
rule T C ip iif 2 set drop 
rule T C ip iif 2 set ah continue meta setname
rule T C ip iif 2 set ah continue meta setname
rule T C ip iif 2 set ah continue meta setname
rule T C ip iif 2 set ah continue meta setname
rule T C ip iifname "eth0";  # L3 layer, by interface name
rule T C ip iiftype 1 meta protocol 1
rule T C ip oif 4 set iif 3
rule T C ip oifname "wlan0";  # L3 layer, by interface name
rule T C ip oiftype 1;
rule T C ip skgid 14;
rule T C ip rtclassid 14;
rule T C ip ibriport "br0";  # L2 layer, by interface name
rule T C ip obriport "br1";  # L2 layer, by interface name
rule T C ip ibrname "under-bridge";
rule T C ip obrname "over-bridge";
rule T C ip protocol icmp jhash "over-bridge";
rule T C ip pkttype broadcast;
rule T C ip ipsec 0;  # 'meta ipsec 0' only in meta_expr
rule T C ip cpu 1;
rule T C ip iifgroup 0;
rule T C ip oifgroup 0;
rule T C ip cgroup 1048577;
rule T C ip time 12;
rule T C ip day Sunday;
rule T C ip hour 23;

rule T C ip meta mark 64;  # length
rule T C ip meta iifname "eth0";  # L3 layer, by interface name
rule T C ip meta iif 2 iif 3 set continue meta setname
rule T C ip meta iiftype 1 meta protocol 1
rule T C ip meta oif 4 set iif 3
rule T C ip meta oifname "wlan0";  # L3 layer, by interface name
rule T C ip meta oiftype 1;
rule T C ip meta skuid 14;
rule T C ip meta rtclassid 14;
rule T C ip meta ibriport "br0";  # L2 layer, by interface name
rule T C ip meta obriport "br1";  # L2 layer, by interface name
rule T C ip meta ibrname "under-bridge";
rule T C ip meta obrname "over-bridge";
rule T C ip meta pkttype broadcast;
rule T C ip meta ipsec 0;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta cpu 1;
rule T C ip meta iifgroup 0;
rule T C ip meta oifgroup 0;
rule T C ip meta cgroup 1048577;
rule T C ip meta time 12;
rule T C ip meta day Sunday;
rule T C ip meta hour 23;

#  - unqualified META, with a value (optional 'meta' used here)
rule t c ip meta mark 0x01;
rule t c ip meta mark 1234;
rule T C ip meta mark 64;  # length
rule T C ip meta mark 0x4;
rule T C ip meta mark 0x1234;
rule T C ip meta mark 0x00000032;
rule T C ip meta mark == 0x1;
rule T C ip meta mark == @my_set_of_marks;
rule T C ip meta mark == { 0x1234, 0x4 };
rule T C ip meta mark != 64;
rule T C ip meta mark != @my_set_of_marks;
rule T C ip meta mark != { 0x1234, 0x4 };
rule T C ip meta mark >= 64;
rule T C ip meta mark <= 64;
rule T C ip meta mark & 0x02 == 0x02;
rule T C ip meta mark in { 0x1234567, 0x0001 };
rule T C ip meta mark in @my_set_of_marks;
rule T C ip meta mark not in @my_set_of_marks;
rule T C ip meta iif any;
rule T C ip meta iif 2;
rule T C ip meta iif == 2;
rule T C ip meta iif != 2;
rule T C ip meta iif eth0;
rule T C ip meta iif "eth0";
rule T C ip meta iif in { 1, "eth0" };
rule T C ip meta iif in @mySetofInterfaceNames;
rule T C ip meta iif not in { 1, "eth0" };
rule T C ip meta iif == eth0;
rule T C ip meta iif == "eth0";
rule T C ip meta iif == @set_of_interface_names;
rule T C ip meta iif == { "eth0", "wlan0", "br0" };
rule T C ip meta iif != eth0;
rule T C ip meta iif != "eth0";
rule T C ip meta iif != { "eth0", "wlan0", "br0" };
rule T C ip meta iif != { "eth0", "wlan0", "br0" };
rule T C ip meta iifname "eth0";
rule T C ip meta iifname { "eth0" };
rule T C ip meta iifname in { "eth0" };
rule T C ip meta iifname any;
rule T C ip meta iifname in @set_name_of_interfaces;
rule T C ip meta iifname == "eth0";
rule T C ip meta iifname == { "eth0" };
rule T C ip meta iifname == @set_name_of_interfaces;
rule T C ip meta iifname != "eth0";
rule T C ip meta iifname != @set_name_of_interfaces;
rule T C ip meta iifname != { "eth0" };
rule T C ip meta iifname in { "eth0" };
rule T C ip meta iifname not in { "eth0" };
rule T C ip meta iifname ~ "^eth.*";  # regex
rule T C ip meta iifname !~ "^eth.*";  # regex
rule T C ip meta iifname !~ "^eth.*";  # regex
# iiftype/oiftype are listed in Linux kernel linux/if_arp.h file.
rule T C ip meta iiftype 1;
rule T C ip meta iiftype == 1;
rule T C ip meta iiftype == { 1, 2, 3};
rule T C ip meta iiftype == @set_name_of_interfaces;
rule T C ip meta iiftype != 1;
rule T C ip meta iiftype != { 1, 2, 3};
rule T C ip meta iiftype != @set_name_of_interfaces;
rule T C ip meta iiftype >= 1;
rule T C ip meta iiftype <= 1;
rule T C ip meta iiftype in {1, 2, 6};
rule T C ip meta iiftype in @setname;
rule T C ip meta iiftype not in {1, 2, 6};
rule T C ip meta iiftype not in @setname;
rule T C ip meta oif any;
rule T C ip meta oif 2;
rule T C ip meta oif == 2;
rule T C ip meta oif != 2;
rule T C ip meta oif eth0;
rule T C ip meta oif "eth0";
rule T C ip meta oif in { 1, "eth0" };
rule T C ip meta oif in @mySetofInterfaceNames;
rule T C ip meta oif not in @mySetofInterfaceNames;
rule T C ip meta oif == eth0;
rule T C ip meta oif == "eth0";
rule T C ip meta oif == @set_of_interface_names;
rule T C ip meta oif == { "eth0", "wlan0", "br0" };
rule T C ip meta oif != eth0;
rule T C ip meta oif != "eth0";
rule T C ip meta oif != { "eth0", "wlan0", "br0" };
rule T C ip meta oif != { "eth0", "wlan0", "br0" };
rule T C ip meta oifname "eth0";
rule T C ip meta oifname { "eth0" };
rule T C ip meta oifname in { "eth0" };
rule T C ip meta oifname any;
rule T C ip meta oifname in @set_name_of_interfaces;
rule T C ip meta oifname not in @set_name_of_interfaces;
rule T C ip meta oifname == "eth0";
rule T C ip meta oifname == { "eth0" };
rule T C ip meta oifname == @set_name_of_interfaces;
rule T C ip meta oifname != "eth0";
rule T C ip meta oifname != @set_name_of_interfaces;
rule T C ip meta oifname != { "eth0" };
rule T C ip meta oifname ~ "^eth.*";  # regex
rule T C ip meta oifname !~ "^eth.*";  # regex
rule T C ip meta oifname !~ "^eth.*";  # regex
rule T C ip meta oiftype 1;
rule T C ip meta oiftype == 1;
rule T C ip meta oiftype == { 1, 2, 3};
rule T C ip meta oiftype == @set_name_of_interfaces;
rule T C ip meta oiftype != 1;
rule T C ip meta oiftype != { 1, 2, 3};
rule T C ip meta oiftype != @set_name_of_interfaces;
rule T C ip meta oiftype >= 1;
rule T C ip meta oiftype <= 1;
rule T C ip meta oiftype in {1, 2, 6};
rule T C ip meta oiftype not in {1, 2, 6};
rule T C ip meta skgid 64;  # length
rule t c ip meta skgid 0x01;
rule t c ip meta skgid 1234;
rule T C ip meta skgid 0x4;
rule T C ip meta skgid 0x1234;
rule T C ip meta skgid 0x00000032;
rule T C ip meta skgid == 0x1;
rule T C ip meta skgid == @my_set_of_skgid;
rule T C ip meta skgid == { 0x1234, 0x4 };
rule T C ip meta skgid != 64;
rule T C ip meta skgid != @my_set_of_skgid;
rule T C ip meta skgid != { 0x1234, 0x4 };
rule T C ip meta skgid >= 64;
rule T C ip meta skgid <= 64;
rule T C ip meta skgid & 0x02 == 0x02;
rule T C ip meta skgid in { 0x1234567, 0x0001 };
rule T C ip meta skgid in @my_set_of_skgid;
rule T C ip meta skgid not in @my_set_of_skgid;
rule T C ip meta skuid 64;  # length
rule t c ip meta skuid 0x01;
rule t c ip meta skuid 1234;
rule T C ip meta skuid 0x4;
rule T C ip meta skuid 0x1234;
rule T C ip meta skuid 0x00000032;
rule T C ip meta skuid == 0x1;
rule T C ip meta skuid == @my_set_of_skuid;
rule T C ip meta skuid == { 0x1234, 0x4 };
rule T C ip meta skuid != 64;
rule T C ip meta skuid != @my_set_of_skuid;
rule T C ip meta skuid != { 0x1234, 0x4 };
rule T C ip meta skuid >= 64;
rule T C ip meta skuid <= 64;
rule T C ip meta skuid & 0x02 == 0x02;
rule T C ip meta skuid in { 0x1234567, 0x0001 };
rule T C ip meta skuid in @my_set_of_skuid;
rule T C ip meta skuid not in @my_set_of_skuid;
# 'meta nftace' requires no argument, but still 'unqualified' (no 'meta' needed).
# 'meta rtclassid' is used with 'realm' keyword, mnemonics are in /etc/iproute2/rt_realms
#
rule T C ip meta rtclassid any;
rule T C ip meta rtclassid 14;
rule T C ip meta ibriport "br0";
rule T C ip meta ibriport { "br0" };
rule T C ip meta ibriport { "br0", "br1" };
rule T C ip meta ibriport in { "br0" };
rule T C ip meta ibriport any;
rule T C ip meta ibriport in @set_name_of_interfaces;
rule T C ip meta ibriport not in @set_name_of_interfaces;
rule T C ip meta ibriport == "br0";
rule T C ip meta ibriport == { "br0" };
rule T C ip meta ibriport == @set_name_of_interfaces;
rule T C ip meta ibriport != "br0";
rule T C ip meta ibriport != @set_name_of_interfaces;
rule T C ip meta ibriport != { "br0" };
rule T C ip meta ibriport ~ "^br.*";  # regex
rule T C ip meta ibriport !~ "^br.*";  # regex
rule T C ip meta ibriport !~ "^br.*";  # regex
rule T C ip meta obriport "br0";
rule T C ip meta obriport { "br0" };
rule T C ip meta obriport in { "br0" };
rule T C ip meta obriport any;
rule T C ip meta obriport in @set_name_of_interfaces;
rule T C ip meta obriport == "br0";
rule T C ip meta obriport == { "br0" };
rule T C ip meta obriport == @set_name_of_interfaces;
rule T C ip meta obriport != "br0";
rule T C ip meta obriport != @set_name_of_interfaces;
rule T C ip meta obriport != { "br0" };
rule T C ip meta obriport ~ "^br.*";  # regex
rule T C ip meta obriport !~ "^br.*";  # regex
rule T C ip meta obriport !~ "^br.*";  # regex
rule T C ip meta ibrname "under-bridge";
rule T C ip meta ibrname {"under-bridge"};
rule T C ip meta ibrname in {"under-bridge"};
rule T C ip meta ibrname in @set_name_of_interfaces;
rule T C ip meta ibrname not in @set_name_of_interfaces;
rule T C ip meta obrname "under-bridge";
rule T C ip meta obrname {"under-bridge"};
rule T C ip meta obrname in {"under-bridge"};
rule T C ip meta obrname in @set_name_of_interfaces;
rule T C ip meta obrname not in @set_name_of_interfaces;
rule T C ip meta pkttype broadcast;
rule T C ip meta pkttype unicast;
rule T C ip meta pkttype multicast;
rule T C ip meta pkttype fastroute;
rule T C ip meta pkttype outgoing;
rule T C ip meta pkttype otherhost;
rule T C ip meta pkttype host;
rule T C ip meta pkttype == { unicast, multicast };
rule T C ip meta pkttype != { unicast, multicast };
rule T C ip meta pkttype in { unicast, multicast };
rule T C ip meta pkttype in @my_packet_types;
rule T C ip meta pkttype not in { broadcast, otherhost, unicast, outgoing, fastroute, loopback, host };
rule T C ip meta pkttype not in @my_packet_types;
rule T C ip ipsec == 1;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec == 1;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec != 1;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec == { 1, missing };  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec == @my_ipsec_settings;
rule T C ip meta ipsec != { missing };  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec != @my_ipsec_settings;
rule T C ip meta ipsec in { 1 };  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec not in { 0 };  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec in { missing };  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec not in { missing };  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec in @my_ipsec_settings;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec not in { exists };  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec not in @my_ipsec_settings;  # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec exists; # 'meta ipsec 0' only in meta_expr
rule T C ip meta ipsec missing; # 'meta ipsec 0' only in meta_expr
rule T C ip meta cpu 1;
rule T C ip meta cpu == 1;
rule T C ip meta cpu in { 1,2,3,8,9,10 };
rule T C ip meta cpu in @my_set_of_cpus;
rule T C ip meta cpu != 1;
rule T C ip meta cpu not in @my_set_of_cpus;
rule T C ip meta cpu not in { 1,2,3,8,9,10 };
rule T C ip meta iifgroup 0;
rule T C ip meta iifgroup == 0;
rule T C ip meta iifgroup != 0;
rule T C ip meta iifgroup < 0;
rule T C ip meta iifgroup <= 0;
rule T C ip meta iifgroup > 0;
rule T C ip meta iifgroup >= 0;
rule T C ip meta iifgroup in { 1,2,4 };
rule T C ip meta iifgroup in @my_set_of_ifgroups;
rule T C ip meta iifgroup not in { 1,2,4 };
rule T C ip meta iifgroup not in @my_set_of_ifgroups;
rule T C ip meta oifgroup 0;
rule T C ip meta oifgroup 1234567890;
rule T C ip meta oifgroup == 0;
rule T C ip meta oifgroup != 0;
rule T C ip meta oifgroup < 0;
rule T C ip meta oifgroup <= 0;
rule T C ip meta oifgroup > 0;
