table ip x {
	chain y {
		ip saddr 2.2.2.2 counter packets 0 bytes 0
	}
}
table ip t {
	map m {
		type ipv4_addr : verdict
	}

	chain c10 {
	}

	chain c9 {
		jump c10
		tcp dport 80 tproxy to :20000 meta mark set 0x00000001 accept
	}

	chain c8 {
		jump c9
	}

	chain c2 {
	}

	chain c1 {
		jump c2
		ip saddr vmap @m
	}

	chain c0 {
		type filter hook input priority filter; policy accept;
		jump c1
	}
}
table ip x {
}
table ip y {
}
table ip x {
	set y {
		type ipv4_addr
	}
}
table ip filter {
	map group_10060 {
		type ipv4_addr : classid
		flags interval
		elements = { 10.1.26.2 : 1:bbf8,
			     10.1.26.3 : 1:c1ad,
			     10.1.26.4 : 1:b2d7,
			     10.1.26.5 : 1:f705,
			     10.1.26.6 : 1:b895,
			     10.1.26.7 : 1:ec4c,
			     10.1.26.8 : 1:de78,
			     10.1.26.9 : 1:b4f3,
			     10.1.26.10 : 1:dec6,
			     10.1.26.11 : 1:b4c0 }
	}
}
table ip filter {
	map client_to_any {
		type ipv4_addr : verdict
	}

	chain FORWARD {
		type filter hook forward priority filter; policy accept;
		goto client_to_any
	}

	chain client_to_any {
		ip saddr vmap @client_to_any
	}
}
