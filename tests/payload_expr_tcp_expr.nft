        tcp sequence 15-2000 accept
        tcp sequence @named_set_tcp_sequence accept
        tcp sequence in { 5, 10, 15 } accept
        tcp sequence in {
             5,
             10,
             15
        } accept;
        tcp ackseq 15 accept
        tcp ackseq > 15 accept
        tcp ackseq 15-2000 accept
        tcp ackseq @named_set_tcp_ackseq accept
        tcp ackseq in { 5, 10, 15 } accept
        tcp ackseq in {
             5,
