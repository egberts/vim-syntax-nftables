
add table T

table T {
    chain C {
        tcp checksum 15 accept
        tcp checksum 15 accept
        tcp checksum 15-2000 accept
        tcp checksum @named_set_tcp_checksum accept
        tcp checksum in { 5, 10, 15 } accept
        tcp checksum in {
             5,
             10,
             15
        } accept

        tcp sequence 15 accept
