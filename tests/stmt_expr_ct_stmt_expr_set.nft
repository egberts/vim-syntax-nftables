

table inet my_table {
    define MY_DEVICE = "eth0"
    set my_zones {
        type number
        elements = { 10, 20 }
    }
    chain my_chain {
        type filter hook prerouting priority 0; policy accept;
        ct zone set oif map { $MY_DEVICE : 1, "virbr0" : 2; } accept  # Output interface name
        ct zone set oif map { 1 : 10, 2 : 20 } accept                    # Output interface index
        ct zone set iif map { 1 : 10, 2 : 20 } accept                    # Input interface index
        ct zone set iifname map { "lo" : 10, "eth0" : 20 } accept        # Input interface name
        ct zone set meta mark map { 10 : 1, 20 : 2 } accept              # Packet mark
        ct zone set ip saddr map { 192.168.1.1 : 1, 192.168.1.2 : 2 } accept  # Source address
        ct zone set ip daddr map { 127.0.0.1 : 1, 192.168.1.255 : 2 } accept  # Destination address
        ct zone set ip protocol map { 6 : 1, 17 : 2 } accept             # Protocol (TCP, UDP)
    }
}
