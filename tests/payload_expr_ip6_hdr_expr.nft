
add table ip T
table T {
    set my_ports { type number; elements = { 80, 443 } }
    set my_flags { type string; elements = { "syn", "ack" } }
    chain C {
        type filter hook input priority 0; policy accept

        ip6 flowlabel 0x2000
        ip6 flowlabel 1234 accept          # Matches specific flow label
        ip6 flowlabel 0x2000 accept          # Matches specific flow label
        ip6 flowlabel @my_flowlabels accept   # Matches named set
        ip6 flowlabel > 1000 accept        # Matches range with comparison
        ip6 flowlabel >= 1000 accept        # Matches range with comparison
        ip6 flowlabel < 1000 accept        # Matches range with comparison
        ip6 flowlabel <= 1000 accept        # Matches range with comparison
        ip6 flowlabel ! 1000 accept        # Matches range with comparison
        ip6 flowlabel not 1000 accept        # Matches range with comparison
        ip6 flowlabel in { 1234, 5678 } drop  # Matches inline set
        ip6 flowlabel not 1000 accept        # nested block guard test data

        ip6 hoplimit 0x2000
        ip6 hoplimit 1234 accept          # Matches specific flow label
        ip6 hoplimit 0x2000 accept          # Matches specific flow label
        ip6 hoplimit @my_flowlabels accept   # Matches named set
        ip6 hoplimit > 1000 accept        # Matches range with comparison
        ip6 hoplimit >= 1000 accept        # Matches range with comparison
        ip6 hoplimit < 1000 accept        # Matches range with comparison
        ip6 hoplimit <= 1000 accept        # Matches range with comparison
        ip6 hoplimit ! 1000 accept        # Matches range with comparison
        ip6 hoplimit not 1000 accept        # Matches range with comparison
        ip6 hoplimit in { 1234, 5678 } drop  # Matches inline set

        ip6 nexthdr 46 accept
        ip6 nexthdr hop-by-hop opt-type 5 accept;
        ip6 nexthdr hop-by-hop opt-len 40 accept
        ip6 nexthdr hop-by-hop opt-data 40 accept
        ip6 nexthdr hop-by-hop opt-data 0x0806 accept
        ip6 nexthdr hop-by-hop @nh,0,8 43 accept  # Hop-by-Hop by Routing Header
        ip6 nexthdr hop-by-hop opt-type 5 @nh,0,8 43 accept  # Hop-by-Hop with Router Alert, followed by Routing Header

        ip6 nexthdr fragment id 1 accept
        ip6 nexthdr fragment id > 1 accept
        ip6 nexthdr fragment id >= 1 accept
        ip6 nexthdr fragment id < 1 accept
        ip6 nexthdr fragment id <= 1 accept
        ip6 nexthdr fragment id != 1 accept
        ip6 nexthdr fragment id ! 1 accept
        ip6 nexthdr fragment id 1-2000 accept
        ip6 nexthdr fragment id @nameset accept
        ip6 nexthdr fragment id in {1,2,3} accept
        ip6 nexthdr fragment not id 1 accept

        ip6 nexthdr fragment offset 1 accept
        ip6 nexthdr fragment offset @nameset accept
        ip6 nexthdr fragment more-fragments accept
        ip6 nexthdr fragment more-fragments accept
        ip6 nexthdr fragment not more-fragments accept
        ip6 nexthdr fragment id in { 1, 2, 3 } accept;
        ip6 nexthdr fragment id in { 1, 2, 3 } accept;
        ip6 nexthdr fragment offset in { 4,5,6 } accept;

        ip6 nexthdr no-next accept

        ip6 nexthdr routing type 2 accept          # Matches Type 2 Routing Header
        ip6 nexthdr routing type in { 0, 2 } drop  # Inline set
        ip6 nexthdr routing type @my_types accept  # Named set
        ip6 nexthdr routing type > 0 accept        # Comparison
        ip6 nexthdr routing segments-left 1 accept         # Matches 1 segment left
        ip6 nexthdr routing segments-left in { 0, 1 } drop # Inline set
        ip6 nexthdr routing segments-left @my_segments accept  # Named set
        ip6 nexthdr routing segments-left > 0 accept       # Comparison
        ip6 nexthdr routing addr fffe:::0001 accept
        ip6 nexthdr routing addr in { fffe:::0001 } accept
        ip6 nexthdr routing addr @my_routing accept  # Named set
        ip6 nexthdr routing addr != fffe:::0001 accept  # Comparison

        icmpv6 
        ip6 nexthdr icmpv6 icmpv6 checksum 1888888888 accept;
        ip6 nexthdr icmpv6 icmpv6 checksum 0x23123123 accept;
        ip6 nexthdr icmpv6 icmpv6 checksum in { 0x123123123, 4234234234, 5345345345 } accept;
        ip6 nexthdr icmpv6 icmpv6 checksum @named_sequences accept
        ip6 nexthdr icmpv6 icmpv6 checksum > 1000000 accept
        ip6 nexthdr icmpv6 icmpv6 sequence 123123123 accept;
        ip6 nexthdr icmpv6 icmpv6 sequence 0x23123123 accept;
        ip6 nexthdr icmpv6 icmpv6 sequence in { 123123123, 4234234234, 5345345345 } accept;
        ip6 nexthdr icmpv6 icmpv6 sequence @named_sequences accept
        ip6 nexthdr icmpv6 icmpv6 sequence > 1000000 accept
        # ICMP ping dealt with separately to rate limit
        ip6 nexthdr icmpv6 icmpv6 type echo-request limit rate over 1/second counter drop
        ip6 nexthdr icmpv6 icmpv6 type echo-request counter accept
        # accept neighbour otherwise IPv6 connectivity breaks.
        ip6 nexthdr icmpv6 icmpv6 type destination-unreachable counter accept;
        ip6 nexthdr icmpv6 icmpv6 type packet-too-big counter accept;
        ip6 nexthdr icmpv6 icmpv6 type time-exceeded counter accept;
        ip6 nexthdr icmpv6 icmpv6 type parameter-problem counter accept;
        ip6 nexthdr icmpv6 icmpv6 type echo-reply counter accept;
        ip6 nexthdr icmpv6 icmpv6 type nd-router-advert counter accept;
        ip6 nexthdr icmpv6 icmpv6 type nd-neighbor-solicit counter accept;
        ip6 nexthdr icmpv6 icmpv6 type nd-neighbor-advert counter accept;
        ip6 nexthdr icmpv6 icmpv6 type echo-request limit rate over 1/second counter drop
        ip6 nexthdr icmpv6 icmpv6 type echo-request counter accept
        # Accept neighbor discovery and other ICMPv6 types
        ip6 nexthdr icmpv6 icmpv6 type destination-unreachable counter accept
        ip6 nexthdr icmpv6 icmpv6 type packet-too-big counter accept
        ip6 nexthdr icmpv6 icmpv6 type time-exceeded counter accept
        ip6 nexthdr icmpv6 icmpv6 type parameter-problem counter accept
        ip6 nexthdr icmpv6 icmpv6 type echo-reply counter accept
        ip6 nexthdr icmpv6 icmpv6 type nd-router-advert counter accept
        ip6 nexthdr icmpv6 icmpv6 type nd-neighbor-solicit counter accept
        ip6 nexthdr icmpv6 icmpv6 type nd-neighbor-advert counter accept
        ip6 nexthdr icmpv6 icmpv6 type ! nd-neighbor-advert counter accept
        ip6 nexthdr icmpv6 icmpv6 type >= nd-neighbor-advert counter accept
        ip6 nexthdr icmpv6 icmpv6 type > nd-neighbor-advert counter accept
        ip6 nexthdr icmpv6 icmpv6 type @namedset_icmpv6_types counter accept
        ip6 nexthdr icmpv6 icmpv6 type in { nd-neighbor-advert, echo-request } counter accept
        # Example for code (specific value required)
        ip6 nexthdr icmpv6 icmpv6 type destination-unreachable code 0 counter accept
        # Example for id and sequence (specific to echo-request/reply)
        ip6 nexthdr icmpv6 icmpv6 type echo-request id 100 sequence 1 counter accept
        ip6 nexthdr icmpv6 icmpv6 code 255 accept;
        ip6 nexthdr icmpv6 icmpv6 code 0x15 accept;
        ip6 nexthdr icmpv6 icmpv6 code in { 7,8, 9} accept;
        ip6 nexthdr icmpv6 icmpv6 code @named_codes accept;
        ip6 nexthdr icmpv6 icmpv6 code > 17 accept;
        ip6 nexthdr icmpv6 icmpv6 id 15 accept;
        ip6 nexthdr icmpv6 icmpv6 id in { 0, 1} accept;
        ip6 nexthdr icmpv6 icmpv6 id @named_ids accept;
        ip6 nexthdr icmpv6 icmpv6 id > 127 accept;
        ip6 nexthdr icmpv6 icmpv6 code 15 id 1 accept;
        ip6 nexthdr icmpv6 icmpv6 id 15 code 15 accept;

        ip6 nexthdr dccp dccp checksum 32767 accept
        ip6 nexthdr dccp dccp checksum 0x3232 accept
        ip6 nexthdr dccp dccp checksum in { 0x1000, 0x2000, 0x3000 } accept
        ip6 nexthdr dccp dccp checksum @named_dccp_checksums accept
        ip6 nexthdr dccp dccp checksum > 32767 accept
        ip6 nexthdr dccp dccp dport 22 accept
        ip6 nexthdr dccp dccp dport 0x16 accept
        ip6 nexthdr dccp dccp dport in { 0x16, 22 } accept
        ip6 nexthdr dccp dccp dport @named_dports accept
        ip6 nexthdr dccp dccp dport > 1024 accept
        ip6 nexthdr dccp dccp sport 22 accept
        ip6 nexthdr dccp dccp sport 0x16 accept
        ip6 nexthdr dccp dccp sport in { 0x16, 22} accept
        ip6 nexthdr dccp dccp sport @named_sports accept
        ip6 nexthdr dccp dccp sport > 1024 accept
        ip6 nexthdr dccp dccp type 5 accept
        ip6 nexthdr dccp dccp type 0x1 accept
        ip6 nexthdr dccp dccp type request accept
        ip6 nexthdr dccp dccp type response accept
        ip6 nexthdr dccp dccp type data accept
        ip6 nexthdr dccp dccp type ack accept
        ip6 nexthdr dccp dccp type dataack accept
        ip6 nexthdr dccp dccp type closereq accept
        ip6 nexthdr dccp dccp type close accept
        ip6 nexthdr dccp dccp type reset accept
        ip6 nexthdr dccp dccp type sync accept
        ip6 nexthdr dccp dccp type syncack accept
        ip6 nexthdr dccp dccp type in { close, 1,4, 5} accept
        ip6 nexthdr dccp dccp type @named_dccp_types accept
        ip6 nexthdr dccp dccp type > 9 drop

        ip6 nexthdr dest opt-data 5
        ip6 nexthdr dest opt-type 5 accept
        ip6 nexthdr dest opt-len 40 accept
        ip6 nexthdr dest opt-data 40 accept
        ip6 nexthdr dest opt-data 0x0806 accept

        ip6 nexthdr sctp checksum 22 accept
        ip6 nexthdr sctp checksum 0x16161616 accept
        ip6 nexthdr sctp checksum 0x16161616-0xffffffff accept
        ip6 nexthdr sctp checksum in { 0x16, 22 } accept
        ip6 nexthdr sctp checksum @named_sctp_dports accept
        ip6 nexthdr sctp checksum > 1024 accept
        ip6 nexthdr sctp dport 22 accept
        ip6 nexthdr sctp dport 0x16 accept
        ip6 nexthdr sctp dport in { 0x16, 22 } accept
        ip6 nexthdr sctp dport @named_sctp_dports accept
        ip6 nexthdr sctp dport > 1024 accept
        ip6 nexthdr sctp sport 22 accept
        ip6 nexthdr sctp sport 0x16 accept
        ip6 nexthdr sctp sport in { 0x16, 22 } accept
        ip6 nexthdr sctp sport @named_sctp_dports accept
        ip6 nexthdr sctp sport > 1024 accept
        ip6 nexthdr sctp vtag 22 accept
        ip6 nexthdr sctp vtag 0x16 accept
        ip6 nexthdr sctp vtag 0x00000000-0x80000000 accept
        ip6 nexthdr sctp vtag in { 0x16, 22 } accept
        ip6 nexthdr sctp vtag @named_sctp_dports accept
        ip6 nexthdr sctp vtag > 1024 accept

        ip6 nexthdr esp spi 22 accept  # specific value, integer
        ip6 nexthdr esp spi 0x16161616 accept  # specific value, hexidecimal
        ip6 nexthdr esp spi 0x16161616-0xffffffff accept  # range
        #ip6 nexthdr esp spi in { 0x16, 22 } accept    # inline set
        ip6 nexthdr esp spi @named_esp_spis accept  # named set
        ip6 nexthdr esp spi > 1024 accept  # comparison
        ip6 nexthdr esp sequence 22 accept  # specific value, integer
        ip6 nexthdr esp sequence 0x16161616 accept  # specific value, hexidecimal
        ip6 nexthdr esp sequence 0x12345678-0x12345678 accept  # range
        ip6 nexthdr esp sequence in { 0x12345678, 0x16, 22 } accept    # inline set
        ip6 nexthdr esp sequence @named_esp_sequences accept  # named set
        ip6 nexthdr esp sequence > 1024 accept  # comparison

        ip6 nexthdr tcp sport 80 accept                    # Source port 80
        ip6 nexthdr tcp sport 0x4c accept                  # Source port 80 (hexidecimal)
        ip6 nexthdr tcp sport in { 80, 443 } drop          # inline set
        ip6 nexthdr tcp sport @my_ports drop               # named set
        ip6 nexthdr tcp sport > 80 drop                    # comparison
        ip6 nexthdr tcp dport 80 accept                    # Source port 80
        ip6 nexthdr tcp dport 0x4c accept                  # Source port 80 (hexidecimal)
        ip6 nexthdr tcp dport in { 80, 443 } drop          # inline set
        ip6 nexthdr tcp dport @my_ports drop               # named set
        ip6 nexthdr tcp dport > 80 drop                    # comparison
        ip6 nexthdr tcp sequence 1000000 accept            # Sequence number
        ip6 nexthdr tcp sequence 0x4c accept               # Sequence number (hexidecimal)
        ip6 nexthdr tcp sequence in { 80, 443 } drop       # inline set
        ip6 nexthdr tcp sequence @my_sequences drop        # named set
        ip6 nexthdr tcp sequence > 80 drop                 # comparison
        ip6 nexthdr tcp ackseq 1000000 accept            # Sequence number
        ip6 nexthdr tcp ackseq 0x4c accept               # Sequence number (hexidecimal)
        ip6 nexthdr tcp ackseq in { 80, 443 } drop       # inline set
        ip6 nexthdr tcp ackseq @my_sequences drop        # named set
        ip6 nexthdr tcp ackseq > 80 drop                 # comparison
        ip6 nexthdr tcp doff 80 accept                    # Source port 80
        ip6 nexthdr tcp doff 0x4c accept                  # Source port 80 (hexidecimal)
        ip6 nexthdr tcp doff in { 80, 443 } drop          # inline set
        ip6 nexthdr tcp doff @my_ports drop               # named set
        ip6 nexthdr tcp doff > 80 drop                    # comparison
        ip6 nexthdr tcp flags 0  accept                   # SYN flag
        ip6 nexthdr tcp flags 0x80  accept                   # SYN flag
        ip6 nexthdr tcp flags syn accept                   # SYN flag
        ip6 nexthdr tcp flags ack accept                   # SYN flag
        ip6 nexthdr tcp flags rst accept                   # SYN flag
        ip6 nexthdr tcp flags psh accept                   # SYN flag
        ip6 nexthdr tcp flags urg accept                   # SYN flag
        ip6 nexthdr tcp flags ecn accept                   # SYN flag
        ip6 nexthdr tcp flags cwr accept                   # SYN flag
        ip6 nexthdr tcp flags in {syn,psh, 1, 0xcf } accept                   # SYN flag
        #ip6 nexthdr tcp flags in { syn, ack } drop         # Inline set for flags
        ip6 nexthdr tcp flags @my_flags accept             # Named set for flags
        ip6 nexthdr tcp window 122 accept                    # Window Size
        ip6 nexthdr tcp window 0x1234 accept               # Sequence number (hexidecimal)
        ip6 nexthdr tcp window in { 80, 443 } drop       # inline set
        ip6 nexthdr tcp window @my_tcp_window drop        # named set
        ip6 nexthdr tcp window > 80 drop                 # comparison
        ip6 nexthdr tcp checksum 1000000 accept            # Sequence number
        ip6 nexthdr tcp checksum 0x4c accept               # Sequence number (hexidecimal)
        ip6 nexthdr tcp checksum in { 80, 443 } drop       # inline set
        ip6 nexthdr tcp checksum @my_checksums drop        # named set
        ip6 nexthdr tcp checksum > 80 drop                 # comparison
        ip6 nexthdr tcp urgptr 122 accept                    # Urgent pointer
        ip6 nexthdr tcp urgptr 0x1234 accept               # Sequence number (hexidecimal)
        ip6 nexthdr tcp urgptr in { 80, 443 } drop       # inline set
        ip6 nexthdr tcp urgptr @my_tcp_urgptrs drop        # named set
        ip6 nexthdr tcp urgptr > 80 drop                 # comparison
        ip6 nexthdr tcp dport 80 sport 443 accept          # mixed expressions
        ip6 nexthdr tcp sport 80 dport 443 accept          # mixed expressions

        ip6 nexthdr udp sport 53 accept                    # Source port 53 (DNS)
        ip6 nexthdr udp sport 0x35 accept                  # Source port 53 (DNS)
        ip6 nexthdr udp sport in { 53, 456 } accept        # inline set
        ip6 nexthdr udp sport @my_sports accept            # named set
        ip6 nexthdr udp sport > 53 accept                  # comparison
        ip6 nexthdr udp dport 53 accept                    # Source port 53 (DNS)
        ip6 nexthdr udp dport 0x35 accept                  # Source port 53 (DNS)
        ip6 nexthdr udp dport in { 53, 456 } accept        # inline set
        ip6 nexthdr udp dport @my_dports accept            # named set
        ip6 nexthdr udp dport > 53 accept                  # comparison
        ip6 nexthdr udp length 127 accept                    # Source port 53 (DNS)
        ip6 nexthdr udp length 0x35 accept                  # Source port 53 (DNS)
        ip6 nexthdr udp length in { 53, 456 } accept        # inline set
        ip6 nexthdr udp length @my_length accept            # named set
        ip6 nexthdr udp length > 53 accept                  # comparison
        ip6 nexthdr udp checksum 127 accept                    # Source port 53 (DNS)
        ip6 nexthdr udp checksum 0x35 accept                  # Source port 53 (DNS)
        ip6 nexthdr udp checksum in { 0x7fff, 0x8000 } accept        # inline set
        ip6 nexthdr udp checksum @my_checksum accept            # named set
        ip6 nexthdr udp checksum > 0x8001 accept                  # comparison

        ip6 nexthdr ah spi 22 accept  # specific value, integer
        ip6 nexthdr ah spi 0x16161616 accept  # specific value, hexidecimal
        ip6 nexthdr ah spi 0x16161616-0xffffffff accept  # range
        ip6 nexthdr ah spi in { 0x16, 22 } accept    # inline set
        ip6 nexthdr ah spi @named_ah_spis accept  # named set
        ip6 nexthdr ah spi > 1024 accept  # comparison
        ip6 nexthdr ah sequence 22 accept  # specific value, integer
        ip6 nexthdr ah sequence 0x16161616 accept  # specific value, hexidecimal
        ip6 nexthdr ah sequence 0x12345678-0x12345678 accept  # range
        ip6 nexthdr ah sequence in { 0x12345678, 0x16, 22 } accept    # inline set
        ip6 nexthdr ah sequence @named_ah_sequences accept  # named set
        ip6 nexthdr ah sequence > 1024 accept  # comparison

        ip6 version 6 accept
        ip6 length 6 accept
        ip6 daddr abcd::100 accept
        ip6 saddr abcd::100 accept
        ip6 dscp 46 drop
        ip6 ecn 46 drop
        ip6 nexthdr tcp accept
    }
}
delete chain C
delete table T
