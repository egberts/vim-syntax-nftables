#!/usr/sbin/nft -f
# File: all-tables.nft
# Description: A test NFT file to exercise 'add table' Vim syntax highlightings.
#
# The imperative part of 'add table', not the declarative 'table' command.
#
# Identifiers begin with an alphabetic character (a-z,A-Z),
# followed by zero or more alphanumeric characters (a-z,A-Z,0-9)
#
# underscore (_) and dot (.) are supported.
#
# Weirdly so, the characters slash (/), backslash (\) seems
# supported but are ignored throughout by this nftables highligher
#
# Syntax Pathway:
#   base_cmd 'add' add_cmd 'table'
#
# Semantic Actions (reverse parser_bison.y):
#   nft_line/nft_base_cmd/nft_base_cmd_add/nft_base_cmd_add_table/nft_add_table_chain_block policy_spec
#
################################################################################
# true positive test (properly hightlighted correctly; has good content; perfect
################################################################################

add table filter

add table my
add table my 
add table my; 
add table my ;
add table my ; 

add table A#;   # not so invalid character, it's an inline comment

add table ip Tip
add table ip6 Tip
add table inet Tip
add table netdev Tip
add table bridge Tip
add table arp Tip

