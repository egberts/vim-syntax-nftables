		counter
		counter name meta mark >> 8 & 0xf map @sctm_o1
		#counter name ip saddr map { 1.1.1.1 : "user123", 2.2.2.2 : "user123", 192.168.2.2 : "user123" }
		counter packets 0 bytes 0
