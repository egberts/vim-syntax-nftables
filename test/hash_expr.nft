#!/usr/sbin/nft -f
# File: hash-expr.nft
# Description: A test NFT file to exercise 'hash' Vim syntax highlightings.
#
# Note: for 'hash' as an expression ('hash_expr') see test/hash-expr.nft
# Note: for 'hash' as a key ('hash_key'), see test/meta-key.nft
#
# If it's followed by a set, it's likely meta_stmt. 
# If it's followed by a field name and then a comparison (==, <, etc.),
#
################################################################################
# true positive test: properly hightlighted correctly; has good content; perfect
################################################################################

# 'describe primary_expr meta_stmt - flags only (support expression only in meta_expr)
describe jhash
describe symhash

# jhash { ip saddr | ip6 daddr | tcp dport | udp sport | ether saddr } […] mod NUM [ seed NUM ] [ offset NUM ]
# symhash mod NUM [ offset NUM ]
table ip nat {
    chain prerouting {
        # Use jhash on source IP to split between two backends
        dnat to jhash ip saddr mod 2 map { 0 : 10.0.0.100, 1 : 10.0.0.200 }
    }
table ip nat {
    chain prerouting {
        dnat to jhash ip saddr mod 2 map { 0 : 10.0.0.100, 1 : 10.0.0.200 }
    }

        # Use symmetric hash (same for both directions) for two backends
table ip nat {
    chain prerouting {
        dnat to symhash mod 2 map { 0 : 10.0.0.100, 1 : 10.0.0.200 }
    }
table ip nat {
    chain prerouting {
        dnat to jhash ip saddr . tcp dport mod 3 map { 
    0 : 192.168.1.10, 
    1 : 192.168.1.11, 
    2 : 192.168.1.12
}
    }
table ip nat {
    chain prerouting {
        dnat to symhash mod 3 map { 0 : 10.0.0.1, 1 : 10.0.0.2, 2 : 10.0.0.3 }
    }
table ip nat {
    chain prerouting {
        dnat to jhash ip saddr mod 4 seed 12345 offset 1 map { 0 : 10.1.1.1, 1 : 10.1.1.2, 2 : 10.1.1.3, 3 : 10.1.1.4 }
    }
}




