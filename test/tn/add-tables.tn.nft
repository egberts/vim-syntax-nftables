# Focus on imperative 'add table'
add table

add table my\=    # defaults to 'ip' family
add table my*_    # defaults to 'ip' family



add table T {
    chain C {
    };
    chain D { };
};

add table $VARIABLE # variable NOT allowed in imperative '^add table'
add table A$
add table A^
add table A$;   # invalid character
add table A%   # invalid character
add table A^   # invalid character
add table A&   # invalid character

add table A*   # invalid character
add table A(   # invalid character
add table A)   # invalid character
add table A+   # invalid character
