
define IP_HDR_LENGTH = 3

table inet t {
    set setname_dscp {
        type inet_service; flags interval;
        elements = { 1, 2, 3, 4 }
    }
    # set setname_dscp_enum {
    #     type inet_service; flags interval;
    #     elements = { cs0, cs1, cs2, cs3 }
    # }
    set setname {
        typeof ip version
        elements = { 1, 4, 6 }
    }
    chain input {
        type filter hook input priority 0;
        ip version 0
        ip version 15
        ip version 0-15
        ip version 0x0
        ip version 0xf
        ip version @setname
        ip version { 1, 2, 3 }
        ip version { 1-4, 6-7 }
        ip version $IP_HDR_LENGTH
        ip version > 0
        ip version > 15
        ip version > 0x0
        ip version > 0xf
        ip version > $IP_HDR_LENGTH
        ip version < 0
        ip version < 15
        ip version < 0x0
        ip version < 0xf
        ip version < $IP_HDR_LENGTH
        ip version >= 0
        ip version >= 15
        ip version >= 0x0
        ip version >= 0xf
        ip version >= $IP_HDR_LENGTH
        ip version <= 0
        ip version <= 15
        ip version <= 0x0
        ip version <= 0xf
        ip version <= $IP_HDR_LENGTH
        ip version == 0
        ip version == 15
        ip version == 0-15
        ip version == 0x0
        ip version == 0xf
        ip version == @setname
        ip version == { 1, 2, 3 }
        ip version == { 1-4, 6-7 }
        ip version == $IP_HDR_LENGTH
        ip version != 0
        ip version != 15
        ip version != 0-15
        ip version != 0x0
        ip version != 0xf
        ip version != @setname
        ip version != { 1, 2, 3 }
        ip version != { 1-4, 6-7 }
        ip version != $IP_HDR_LENGTH
        ip hdrlength 4 
        ip hdrlength 5
        ip hdrlength 15
        ip hdrlength > 5
        ip hdrlength > 15
        ip hdrlength > 0x5
        ip hdrlength > 0xf
        ip hdrlength > $IP_HDR_LENGTH
        ip hdrlength < 5
        ip hdrlength < 15
        ip hdrlength < 0x5
        ip hdrlength < 0xf
        ip hdrlength < $IP_HDR_LENGTH
        ip hdrlength >= 5
        ip hdrlength >= 15
        ip hdrlength >= 0x5
        ip hdrlength >= 0xf
        ip hdrlength >= $IP_HDR_LENGTH
        ip hdrlength <= 5
        ip hdrlength <= 15
        ip hdrlength <= 0x5
        ip hdrlength <= 0xf
        ip hdrlength <= $IP_HDR_LENGTH
        ip hdrlength == 5
        ip hdrlength == 15
        ip hdrlength == 5-15
        ip hdrlength == 0x5
        ip hdrlength == 0xf
        ip hdrlength == @setname
        ip hdrlength == { 0x5, 6, 7 }
        ip hdrlength == { 5-6, 6-7, 9-9, 10-15 }
        ip hdrlength == $IP_HDR_LENGTH
        ip hdrlength != 5
        ip hdrlength != 15
        ip hdrlength != 5-15
        ip hdrlength != 0x5
        ip hdrlength != 0xf
        ip hdrlength != @setname
        ip hdrlength != { 5, 6, 11 }
        ip hdrlength != { 5-6, 6-7 }
        ip hdrlength != $IP_HDR_LENGTH
    }
}
