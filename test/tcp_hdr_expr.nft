add table T 
table T {
  chain C_dport {
    tcp dport 0 accept
    tcp dport 15 accept
    tcp dport 0x0 accept
    tcp dport 0xf accept
    tcp dport 0-15 accept
    tcp dport ssh accept
    tcp dport $IP_HDR_VERSION accept
    tcp dport == 0x10 accept  # overflowed 16-bit
    tcp dport != 0x7 accept
    tcp dport > 0x1 accept
    tcp dport >= 0x2 accept
    tcp dport <= 0x3 accept
    tcp dport < 0x4 accept
    tcp dport { 1,2,4 } accept
    tcp dport { ssh } accept
    tcp dport != { 1,2,4 } accept
    tcp dport == { 1,2,4 } accept
  }
}

